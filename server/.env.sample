NODE_ENV=development
PORT=4000
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=your-secure-random-string-change-in-production
JWT_EXPIRES=7d
# Optional: other sites allowed to call the API with cookies (comma-separated).
# Leave empty when the app and API share a domain (the normal setup).
CLIENT_ORIGIN=
# Optional: timezone for date filters when the browser does not send one (e.g. America/New_York)
APP_TIMEZONE=
